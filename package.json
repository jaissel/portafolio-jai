{
  "name": "jai-portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "wrangler pages dev dist",
    "postinstall": "nuxt prepare",
    "assets": "node scripts/build-avatars.mjs && node scripts/build-fonts.mjs && node scripts/build-og.mjs",
    "db:migrate": "wrangler d1 migrations apply jai-portfolio --local",
    "db:migrate:remote": "wrangler d1 migrations apply jai-portfolio --remote",
    "db:seed": "node scripts/seed.mjs --local",
    "db:seed:remote": "node scripts/seed.mjs --remote",
    "deploy": "nuxt build && wrangler pages deploy dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "og": "node scripts/build-og.mjs",
    "fonts": "node scripts/build-fonts.mjs"
  },
  "dependencies": {
    "@nuxt/fonts": "^1.0.1",
    "nuxt": "^4.6.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@nuxt/eslint": "^1.17.0",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "nitro-cloudflare-dev": "^0.2.2",
    "prettier": "^3.9.10",
    "satori": "^0.51.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.149.0"
  }
}
